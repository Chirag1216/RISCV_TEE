# Kernel options for the rvtee guest: a small QEMU-virt kernel with PREEMPT_RT.
# Applied on top of tinyconfig.
CONFIG_ARCH_VIRT=y
CONFIG_NONPORTABLE=n
CONFIG_SMP=n
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_SBI_V01=y
# Read the CPU extensions from the older "riscv,isa" property too (needed by QEMU < 9)
CONFIG_RISCV_ISA_FALLBACK=y

# Real time
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_POSIX_TIMERS=y

# Console
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# Root filesystem in an initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# What ordinary user programs expect
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_BASE_FULL=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y

# Loadable modules (for the dtee driver) and readable crash reports
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
